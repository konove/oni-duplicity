{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format-edited-file.js",
            "timeout": 30,
            "statusMessage": "Formatting with prettier..."
          }
        ]
      }
    ]
  }
}
