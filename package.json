{
  "name": "oni-duplicity",
  "friendlyName": "Duplicity",
  "version": "3.28.0",
  "description": "A web-based Oxygen Not Included save file editor.",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "cross-env NODE_ENV=production webpack --config ./webpack.config.js",
    "typecheck": "tsc -p src --noEmit && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:e2e": "docker compose run --rm -T e2e",
    "test:e2e:update": "docker compose run --rm -T e2e --update-snapshots",
    "test:e2e:native": "playwright test --ignore-snapshots",
    "start": "cross-env NODE_ENV=development webpack serve --config ./webpack.config.js",
    "start:prod": "cross-env NODE_ENV=production webpack serve --config ./webpack.config.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -r https://github.com/konove/oni-duplicity"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/konove/oni-duplicity.git"
  },
  "keywords": [
    "ONI",
    "OxygenNotIncluded",
    "save-editor"
  ],
  "author": "RoboPhred <robophred@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/object-hash": "^3.0.6",
    "@types/platform": "^1.3.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/webpack-env": "^1.18.8",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.11.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "webpack": "5.109.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "workbox-webpack-plugin": "^7.4.1"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-tree-view": "^9.12.0",
    "classnames": "^2.5.1",
    "file-saver": "^2.0.5",
    "i18next": "^26.4.0",
    "lodash": "^4.18.1",
    "object-hash": "^3.0.0",
    "oni-save-parser": "github:konove/oni-save-parser#ee7f14c",
    "platform": "^1.3.6",
    "re-reselect": "^5.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "react-oni-duplicant": "^0.1.3",
    "react-redux": "^9.3.0",
    "react-router": "^7.18.3",
    "redux": "^5.0.1",
    "redux-saga": "^1.5.1",
    "reselect": "^5.3.0"
  }
}
